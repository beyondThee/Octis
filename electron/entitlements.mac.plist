<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac permissions for the signed app (hardened runtime).
  Applied to the Electron app AND the bundled Python backend.
-->
<plist version="1.0">
<dict>
  <!-- Electron's JavaScript engine needs these -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- PyInstaller + torch load their own libraries at runtime -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Lecture recording (the Python backend opens the mic) -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
