{
  "name": "quick-notes",
  "version": "1.1.6",
  "description": "AI-powered lecture note taker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.quicknotes.app",
    "productName": "Quick Notes",
    "publish": {
      "provider": "github",
      "owner": "beyondThee",
      "repo": "Octis",
      "releaseType": "release"
    },
    "directories": {
      "output": "../dist_electron"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist_python/app/",
        "to": "python/",
        "filter": ["**/*"]
      },
      {
        "from": "../icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "../icon.png",
      "category": "public.app-category.education"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quick Notes",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
