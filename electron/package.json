{
  "name": "quick-notes",
  "version": "1.3.2",
  "description": "AI-powered lecture note taker",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.quicknotes.app",
    "productName": "Quick Notes",
    "publish": {
      "provider": "github",
      "owner": "beyondThee",
      "repo": "Octis",
      "releaseType": "release"
    },
    "directories": {
      "output": "../dist_electron"
    },
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist_python/app/",
        "to": "python/",
        "filter": ["**/*"]
      },
      {
        "from": "../icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../icon.ico",
      "artifactName": "Quick-Notes-Setup.${ext}"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "icon": "../icon.png",
      "category": "public.app-category.education",
      "artifactName": "Quick-Notes.${ext}",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Quick Notes uses your microphone to record lectures and turn them into notes. Audio is transcribed on your Mac and never uploaded.",
        "NSDocumentsFolderUsageDescription": "Quick Notes saves your lectures, notes and flashcards in Documents/Octis."
      }
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Quick Notes",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.1.7"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  }
}
